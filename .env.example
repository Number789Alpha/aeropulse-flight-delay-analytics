# Database Configuration Template
# For MS SQL Server Local / Express
DB_TYPE=sqlserver
DB_SERVER=localhost
DB_NAME=FlightDelaysDB
DB_TRUSTED_CONNECTION=yes

# For Azure SQL or Remote SQL Server
# DB_SERVER=your-azure-server.database.windows.net
# DB_USER=your_username
# DB_PASSWORD=your_password

# For SQLite Portable / Cloud Mode
# DB_TYPE=sqlite
# DB_PATH=data/flights.db

# Security & Role-Based Access Control (RBAC)
# Configure custom admin credentials (or set via Streamlit Cloud Secrets)
AEROPULSE_ADMIN_USER=admin
AEROPULSE_ADMIN_PASS=aeropulse2026
